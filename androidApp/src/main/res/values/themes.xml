<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose draws everything; the window theme only sets what's behind it. -->
    <style name="Theme.DiaRoutine" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/canvas</item>
    </style>

    <style name="Theme.DiaRoutine.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/canvas</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/icon_background</item>
        <item name="postSplashScreenTheme">@style/Theme.DiaRoutine</item>
    </style>
</resources>
